{
  "name": "shanhe-moshi",
  "private": true,
  "version": "1.0.0",
  "description": "山河墨史 —— 水墨风格的世界历史疆域与大事件交互地图",
  "license": "GPL-3.0-only",
  "homepage": "https://shanhe-ink-atlas.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheapCoder/shanhe-ink-atlas.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data:raw": "node scripts/fetch_raw.mjs data_raw",
    "data:borders": "node scripts/build_borders.mjs data_raw/basemaps public/data/borders",
    "data:base": "node scripts/build_base.mjs data_raw/naturalearth public/data/base",
    "data:relief": "node scripts/build_relief.mjs data_raw/relief/SR_50M.tif public/data/base/relief.webp 4096",
    "data:wiki": "node scripts/fetch_wiki.mjs",
    "data:verify": "node scripts/verify_data.mjs",
    "data:lint": "node scripts/check_data.mjs",
    "data:check": "node scripts/check_borders.mjs public/data/borders"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/ma-shan-zheng": "5.3.1",
    "@fontsource/noto-serif-sc": "5.3.0",
    "d3-ease": "3.0.1",
    "d3-geo": "3.1.1",
    "d3-interpolate": "3.0.1",
    "d3-scale": "4.0.2",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "d3-timer": "3.0.1",
    "d3-zoom": "3.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "topojson-client": "3.1.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/d3-ease": "3.0.2",
    "@types/d3-geo": "3.1.0",
    "@types/d3-interpolate": "3.0.4",
    "@types/d3-scale": "4.0.9",
    "@types/d3-selection": "3.0.11",
    "@types/d3-shape": "3.1.7",
    "@types/d3-timer": "3.0.2",
    "@types/d3-zoom": "3.0.8",
    "@types/geojson": "7946.0.16",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitejs/plugin-react": "6.1.2",
    "mapshaper": "0.7.72",
    "polygon-clipping": "0.15.7",
    "polylabel": "2.1.0",
    "sharp": "0.35.5",
    "topojson-server": "3.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
